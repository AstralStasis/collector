PORT=4173
HOST=127.0.0.1

# MySQL 8.0.24+. Create the database/user first; tables are migrated automatically.
DATABASE_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=eorzea_archive
MYSQL_USER=eorzea
MYSQL_PASSWORD=replace-with-your-password
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT=10000
# Alternative to host/user/password/database (URL-encode special characters):
# MYSQL_URL=mysql://eorzea:password@127.0.0.1:3306/eorzea_archive
# Remote TLS with certificate verification:
# MYSQL_SSL=true
# MYSQL_SSL_CA=./certs/ca.pem

# SQLite compatibility: set DATABASE_CLIENT=sqlite instead of mysql.
# DATABASE_PATH=./data/eorzea.sqlite

# HTTPS deployment: set the real site origin and secure cookies.
# PUBLIC_ORIGIN=https://your-archive.example
# NODE_ENV=production
# COOKIE_SECURE=true
