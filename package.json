{
  "name": "eorzea-archive",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node scripts/database.mjs seed",
    "db:backup": "node scripts/database.mjs backup",
    "db:health": "node scripts/database.mjs health",
    "catalog:sync": "node scripts/sync-collect-catalog.mjs",
    "catalog:assets": "node scripts/sync-collect-assets.mjs --catalog catalog.json"
  },
  "engines": {
    "node": ">=12.20.2",
    "npm": ">=6.14.11"
  },
  "dependencies": {
    "mysql2": "3.14.4",
    "dotenv": "16.6.1",
    "node-fetch": "2.7.0",
    "abort-controller": "3.0.0",
    "sql.js": "1.8.0"
  }
}
